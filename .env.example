# ─────────────────────────────────────────────────────────────────────────────
# Pocket Score — environment secrets TEMPLATE
# Copy this file to .env and fill in your real values.
# .env is git-ignored; .env.example is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Settings → API → Project URL
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Settings → API → anon / public key
SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>

# ── Google OAuth 2.0 Client IDs ───────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Web application client ID
GOOGLE_WEB_CLIENT_ID=<your-web-client-id>.apps.googleusercontent.com

# Google Cloud Console → APIs & Services → Credentials → iOS client ID
GOOGLE_IOS_CLIENT_ID=<your-ios-client-id>.apps.googleusercontent.com

# Reversed iOS client ID — used as the CFBundleURLScheme in ios/Runner/Info.plist
# Format: com.googleusercontent.apps.<your-ios-client-id>
GOOGLE_IOS_REVERSED_CLIENT_ID=com.googleusercontent.apps.<your-ios-client-id>
